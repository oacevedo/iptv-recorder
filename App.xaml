<Application x:Class="IptvRecorder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IptvRecorder"
             ShutdownMode="OnExplicitShutdown"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Contenido de los botones con icono: el símbolo delante del texto. El símbolo
             se indica con la propiedad adjunta Icon.Glyph y desaparece si no se pone. -->
        <DataTemplate x:Key="IconContent">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"
                           Text="{Binding Path=(local:Icon.Glyph), RelativeSource={RelativeSource AncestorType=ButtonBase}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,7,0"/>
                            <Style.Triggers>
                                <DataTrigger Value=""
                                             Binding="{Binding Path=(local:Icon.Glyph), RelativeSource={RelativeSource AncestorType=ButtonBase}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

    </Application.Resources>
</Application>
