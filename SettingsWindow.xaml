<Window x:Class="IptvRecorder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}" Height="440" Width="660" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="6,4,0,4"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Set_Language}"/>
        <ComboBox x:Name="LanguageBox" Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,4"
                  DisplayMemberPath="Name" SelectedValuePath="Code"/>

        <TextBlock Grid.Row="1" Text="{DynamicResource Set_Ffmpeg}"/>
        <TextBox x:Name="FfmpegBox" Grid.Row="1" Grid.Column="1" ToolTip="{DynamicResource Set_Ffmpeg_Tip}"/>
        <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Btn_Browse}" Click="BrowseFfmpeg_Click"/>

        <TextBlock Grid.Row="2" Text="{DynamicResource Set_Output}"/>
        <TextBox x:Name="OutputBox" Grid.Row="2" Grid.Column="1"/>
        <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource Btn_Browse}" Click="BrowseOutput_Click"/>

        <TextBlock Grid.Row="3" Text="{DynamicResource Set_Player}"/>
        <TextBox x:Name="PlayerBox" Grid.Row="3" Grid.Column="1" ToolTip="{DynamicResource Set_Player_Tip}"/>
        <Button Grid.Row="3" Grid.Column="2" Content="{DynamicResource Btn_Browse}" Click="BrowsePlayer_Click"/>

        <TextBlock Grid.Row="4" Text="{DynamicResource Set_UA}"/>
        <TextBox x:Name="UserAgentBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" ToolTip="{DynamicResource Set_UA_Tip}"/>

        <TextBlock Grid.Row="5" Text="{DynamicResource Set_Lead}"/>
        <TextBox x:Name="LeadBox" Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" TextAlignment="Center"
                 ToolTip="{DynamicResource Set_Lead_Tip}"/>

        <CheckBox x:Name="ConvertBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Content="{DynamicResource Set_Convert}"/>
        <CheckBox x:Name="TrayBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Content="{DynamicResource Set_Tray}"/>
        <CheckBox x:Name="AutostartBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Content="{DynamicResource Set_Autostart}"/>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Btn_Cancel}" IsCancel="True"/>
            <Button Content="{DynamicResource Btn_Save}" IsDefault="True" Click="Save_Click" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
