<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Main window -->
    <sys:String x:Key="App_Title">IPTV Recorder</sys:String>
    <sys:String x:Key="M3u_Label">M3U list:</sys:String>
    <sys:String x:Key="M3u_Tip">Paste your provider's M3U link here</sys:String>
    <sys:String x:Key="Btn_LoadList">Load list</sys:String>
    <sys:String x:Key="Btn_Settings">Settings</sys:String>
    <sys:String x:Key="Channels_Header">Channels</sys:String>
    <sys:String x:Key="Search_Tip">Search channel by name</sys:String>
    <sys:String x:Key="Btn_OpenExternal">Open in VLC</sys:String>
    <sys:String x:Key="Btn_OpenExternal_Tip">Opens the channel in VLC in a separate window</sys:String>
    <sys:String x:Key="Btn_Preview">Preview</sys:String>
    <sys:String x:Key="Btn_Preview_Tip">Plays the channel in the preview panel. Double-click also works.</sys:String>
    <sys:String x:Key="Col_Channel">Channel</sys:String>
    <sys:String x:Key="Col_Group">Group</sys:String>
    <sys:String x:Key="Preview_Header">Preview</sys:String>
    <sys:String x:Key="Preview_None">No channel playing</sys:String>
    <sys:String x:Key="Preview_Placeholder">Select a channel and press "Preview"</sys:String>
    <sys:String x:Key="Volume_Label">Volume</sys:String>
    <sys:String x:Key="Btn_Mute">Mute</sys:String>
    <sys:String x:Key="Btn_Stop">Stop</sys:String>
    <sys:String x:Key="Btn_WatchRecording">Watch recording</sys:String>
    <sys:String x:Key="Btn_WatchRecording_Tip">Watch the selected recording as it records, without opening another connection to the provider</sys:String>
    <sys:String x:Key="Preview_Live">{0} (recording)</sys:String>
    <sys:String x:Key="NewRec_Header">New recording</sys:String>
    <sys:String x:Key="Channel_Label">Channel:</sys:String>
    <sys:String x:Key="SelectChannel_Hint">(select a channel from the list)</sys:String>
    <sys:String x:Key="Title_Label">Title:</sys:String>
    <sys:String x:Key="Title_Tip">File name, for example: Real Madrid - Barcelona</sys:String>
    <sys:String x:Key="Start_Label">Start:</sys:String>
    <sys:String x:Key="Time_Tip">24-hour time, for example 20:55</sys:String>
    <sys:String x:Key="Duration_Label">Duration:</sys:String>
    <sys:String x:Key="Minutes_Short">min</sys:String>
    <sys:String x:Key="Btn_RecordNow">Record now</sys:String>
    <sys:String x:Key="Btn_Schedule">Schedule</sys:String>
    <sys:String x:Key="Recordings_Header">Recordings</sys:String>
    <sys:String x:Key="Btn_Delete">Delete</sys:String>
    <sys:String x:Key="Btn_ClearFinished">Clear finished</sys:String>
    <sys:String x:Key="Btn_OpenFile">Open file</sys:String>
    <sys:String x:Key="Btn_OpenFolder">Open folder</sys:String>
    <sys:String x:Key="Col_Title">Title</sys:String>
    <sys:String x:Key="Col_Start">Start</sys:String>
    <sys:String x:Key="Col_Min">Min</sys:String>
    <sys:String x:Key="Col_Status">Status</sys:String>
    <sys:String x:Key="Col_Detail">Detail</sys:String>
    <sys:String x:Key="Status_Ready">Ready</sys:String>

    <!-- Recording statuses -->
    <sys:String x:Key="Rec_Pending">Pending</sys:String>
    <sys:String x:Key="Rec_Recording">Recording</sys:String>
    <sys:String x:Key="Rec_Converting">Converting</sys:String>
    <sys:String x:Key="Rec_Completed">Completed</sys:String>
    <sys:String x:Key="Rec_Failed">Failed</sys:String>
    <sys:String x:Key="Rec_Cancelled">Cancelled</sys:String>

    <!-- Main window messages -->
    <sys:String x:Key="Msg_PasteM3u">Paste the M3U link first.</sys:String>
    <sys:String x:Key="Status_Downloading">Downloading list...</sys:String>
    <sys:String x:Key="Msg_NoChannels">The list was downloaded but contains no recognizable channels.</sys:String>
    <sys:String x:Key="Msg_DownloadFailed">Could not download the list:&#10;{0}</sys:String>
    <sys:String x:Key="Status_LoadError">Error loading the list</sys:String>
    <sys:String x:Key="AllGroups">All groups</sys:String>
    <sys:String x:Key="Channels_Count">{0} channels</sys:String>
    <sys:String x:Key="Status_CacheLoaded">List loaded from cache. Press "Load list" to refresh it.</sys:String>
    <sys:String x:Key="Status_ListLoaded">List loaded: {0} channels</sys:String>
    <sys:String x:Key="Msg_SelectChannel">Select a channel from the list.</sys:String>
    <sys:String x:Key="Msg_BadDuration">Duration must be a number of minutes between 1 and 1440.</sys:String>
    <sys:String x:Key="Msg_BadDateTime">Enter a valid date and time (for example 20:55).</sys:String>
    <sys:String x:Key="Msg_TimePassed">That time has already passed.</sys:String>
    <sys:String x:Key="Status_Scheduled">Scheduled "{0}" for {1} at {2}</sys:String>
    <sys:String x:Key="Status_Stopping">Stopping recording...</sys:String>
    <sys:String x:Key="Log_CancelledByUser">Cancelled by the user</sys:String>
    <sys:String x:Key="Msg_StopBeforeDelete">Stop the recording before deleting it.</sys:String>
    <sys:String x:Key="Status_FolderError">Could not open the folder: {0}</sys:String>
    <sys:String x:Key="Status_SettingsSaved">Settings saved</sys:String>
    <sys:String x:Key="Msg_PreviewWhileRecording">A recording is in progress. Previewing another channel opens a second connection to the provider and, if your service only allows one, it may cut the recording.&#10;&#10;To watch what is being recorded, use "Watch recording": it uses no extra connection.&#10;&#10;Open the preview anyway?</sys:String>
    <sys:String x:Key="Status_ExternalOpened">"{0}" opened in {1}. Close it before the recording starts.</sys:String>
    <sys:String x:Key="Status_PreviewStopped">Preview stopped</sys:String>
    <sys:String x:Key="Status_WatchingRecording">Watching "{0}" from the recording itself, without a second connection to the provider</sys:String>
    <sys:String x:Key="Status_SwitchingToRecording">Recording of "{0}" is starting. Switching the preview to the recording itself...</sys:String>
    <sys:String x:Key="Msg_SelectActiveRecording">Select a recording that is currently in progress.</sys:String>
    <sys:String x:Key="Msg_LiveUnavailable">This recording has no local feed available. Start it again to watch it while it records.</sys:String>
    <sys:String x:Key="Status_PreviewStarted">Previewing "{0}". It will stop by itself when a recording starts.</sys:String>
    <sys:String x:Key="Msg_PreviewFailed">Could not start the preview:&#10;{0}</sys:String>
    <sys:String x:Key="Status_PreviewClosedForRecording">Preview closed to free the connection: recording of "{0}" is starting</sys:String>
    <sys:String x:Key="Tray_Open">Open</sys:String>
    <sys:String x:Key="Tray_Exit">Exit</sys:String>
    <sys:String x:Key="Tray_Balloon">Still running in the system tray. Scheduled recordings will run as planned.</sys:String>
    <sys:String x:Key="Msg_ExitRecording">A recording is in progress. If you exit now it will stop. Exit anyway?</sys:String>
    <sys:String x:Key="Msg_ExitPending">There are scheduled recordings that will not run while the app is closed. Exit anyway?</sys:String>
    <sys:String x:Key="Status_FfmpegMissing">Warning: ffmpeg not found. Set its path in Settings.</sys:String>
    <sys:String x:Key="Err_VlcPlay">VLC could not play the channel</sys:String>
    <sys:String x:Key="Err_NoPlayer">Neither VLC nor ffplay was found. Set a player in Settings.</sys:String>

    <!-- Scheduler -->
    <sys:String x:Key="Log_ClosedDuringRecording">The application was closed during the recording</sys:String>
    <sys:String x:Key="Log_Missed">Start time passed while the app was not running</sys:String>
    <sys:String x:Key="Log_FfmpegMissing">ffmpeg not found. Set its path in Settings.</sys:String>
    <sys:String x:Key="Log_OutputFolderError">Could not create the output folder: {0}</sys:String>
    <sys:String x:Key="Log_FfmpegStartError">Could not start ffmpeg: {0}</sys:String>
    <sys:String x:Key="Log_Connecting">Connecting...</sys:String>
    <sys:String x:Key="Log_Recording">Recording "{0}" -> {1}</sys:String>
    <sys:String x:Key="Log_ExitNoData">ffmpeg exited (code {0}) with no usable data: {1}</sys:String>
    <sys:String x:Key="Log_Failed">Failed "{0}": {1}</sys:String>
    <sys:String x:Key="Log_Converting">Converting to MP4...</sys:String>
    <sys:String x:Key="Log_ConvertFailed">MP4 conversion failed: {0}</sys:String>
    <sys:String x:Key="Log_SavedAsTs">Saved as .ts (MP4 conversion failed)</sys:String>
    <sys:String x:Key="Log_StoppedManually">Stopped manually ({0} MB)</sys:String>
    <sys:String x:Key="Log_Completed">Completed ({0} MB)</sys:String>
    <sys:String x:Key="Log_Finished">Finished "{0}" -> {1}</sys:String>

    <!-- Settings window -->
    <sys:String x:Key="Settings_Title">Settings</sys:String>
    <sys:String x:Key="Set_Ffmpeg">ffmpeg path:</sys:String>
    <sys:String x:Key="Set_Ffmpeg_Tip">Leave empty to find it automatically in the PATH</sys:String>
    <sys:String x:Key="Btn_Browse">Browse...</sys:String>
    <sys:String x:Key="Set_Output">Output folder:</sys:String>
    <sys:String x:Key="Set_Player">Player (Open in VLC):</sys:String>
    <sys:String x:Key="Set_Player_Tip">Leave empty to use VLC if installed, otherwise ffplay</sys:String>
    <sys:String x:Key="Set_UA">User-Agent:</sys:String>
    <sys:String x:Key="Set_UA_Tip">Some providers only accept well-known players</sys:String>
    <sys:String x:Key="Set_Lead">Start early (seconds):</sys:String>
    <sys:String x:Key="Set_Lead_Tip">Margin so the stream connects before the match starts</sys:String>
    <sys:String x:Key="Set_Language">Language:</sys:String>
    <sys:String x:Key="Lang_Auto">Automatic (system)</sys:String>
    <sys:String x:Key="Set_Convert">Convert to MP4 when finished (no re-encoding, takes a few seconds)</sys:String>
    <sys:String x:Key="Set_Tray">Keep running in the system tray when closed or minimized</sys:String>
    <sys:String x:Key="Set_Autostart">Start with Windows (in the tray)</sys:String>
    <sys:String x:Key="Btn_Cancel">Cancel</sys:String>
    <sys:String x:Key="Btn_Save">Save</sys:String>
    <sys:String x:Key="Set_Detected">Detected automatically: {0}</sys:String>
    <sys:String x:Key="Set_PlayerNotFound">Neither VLC nor ffplay was found</sys:String>
    <sys:String x:Key="Dlg_SelectFfmpeg">Select ffmpeg.exe</sys:String>
    <sys:String x:Key="Dlg_SelectPlayer">Select the player for the preview</sys:String>
    <sys:String x:Key="Dlg_OutputFolder">Folder where recordings will be saved</sys:String>
    <sys:String x:Key="Filter_Ffmpeg">ffmpeg.exe|ffmpeg.exe|Executables|*.exe</sys:String>
    <sys:String x:Key="Filter_Player">Player|vlc.exe;ffplay.exe;*.exe</sys:String>
    <sys:String x:Key="Msg_FfmpegMissingFile">That ffmpeg file does not exist.</sys:String>
    <sys:String x:Key="Msg_FfmpegNotInPath">ffmpeg was not found in the PATH. Enter the path to ffmpeg.exe.</sys:String>
    <sys:String x:Key="Msg_PlayerMissingFile">That player file does not exist.</sys:String>
    <sys:String x:Key="Msg_OutputRequired">Enter an output folder.</sys:String>
    <sys:String x:Key="Msg_LeadRange">The start margin must be between 0 and 600 seconds.</sys:String>

</ResourceDictionary>
